<?xml version="1.0"?>

<robot name="robot" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <xacro:arg name="use_cad_visual" default="true" />
  <xacro:arg name="cad_visual_scale" default="1.0" />
  <xacro:property name="length_wheel" value="0.065" />
  <xacro:property name="radius_wheel" value="0.080" />
  <xacro:property name="omni_contact_radius" value="${radius_wheel}" />
  <xacro:property name="wheel_center_offset" value="0.218" />
  <xacro:property name="folded_vehicle_height" value="0.240" />
  <xacro:property name="folded_top_z" value="${folded_vehicle_height - radius_wheel}" />
  <xacro:property name="cad_body_z_scale" value="${folded_top_z / 0.16638150811195374}" />
  <xacro:property name="cad_sensor_z_scale" value="${(folded_top_z - 0.130) / (0.168313 - 0.130)}" />
  <xacro:property name="omni_friction" value="0.05" />
  <xacro:property name="body_mass" value="8.2" />
  <xacro:property name="wheel_mass" value="0.5" />
  <xacro:property name="PI" value="3.1415926"/>
  <material name="cad_body"><color rgba="0.26 0.29 0.32 1" /></material>
  <material name="cad_wheels"><color rgba="0.025 0.025 0.028 1" /></material>
  <material name="cad_armor"><color rgba="0.62 0.035 0.035 1" /></material>
  <material name="cad_sensors"><color rgba="0.08 0.24 0.30 1" /></material>
  <xacro:macro name="box_inertial" params="mass x y z ox oy oz">
    <inertial>
      <origin xyz="${ox} ${oy} ${oz}" rpy="0 0 0" />
      <mass value="${mass}" />
      <inertia ixx="${mass * (y*y + z*z) / 12.0}" ixy="0.0" ixz="0.0"
               iyy="${mass * (x*x + z*z) / 12.0}" iyz="0.0"
               izz="${mass * (x*x + y*y) / 12.0}" />
    </inertial>
  </xacro:macro>
  <xacro:macro name="sphere_inertial" params="mass radius">
    <inertial>
      <mass value="${mass}" />
      <inertia ixx="${0.4 * mass * radius * radius}" ixy="0.0" ixz="0.0"
               iyy="${0.4 * mass * radius * radius}" iyz="0.0"
               izz="${0.4 * mass * radius * radius}" />
    </inertial>
  </xacro:macro>
  <xacro:macro name="cad_visual" params="mesh material z_scale:=1.0 z_origin:=0.0">
    <visual>
      <geometry>
        <mesh filename="package://rm_27_stimulation/meshes/rm27_sentry_visual/${mesh}.stl"
              scale="$(arg cad_visual_scale) $(arg cad_visual_scale) ${float('$(arg cad_visual_scale)') * z_scale}" />
      </geometry>
      <origin xyz="0 0 ${float('$(arg cad_visual_scale)') * z_origin}" />
      <material name="${material}" />
    </visual>
  </xacro:macro>
  <!-- mu1/mu2 are converted only to ODE friction. Keep Bullet explicit so
       changing physics engines does not silently restore its default 1.0. -->
  <xacro:macro name="bullet_omni_friction">
    <collision>
      <surface>
        <friction>
          <bullet>
            <friction>${omni_friction}</friction>
            <friction2>${omni_friction}</friction2>
            <rolling_friction>0.0</rolling_friction>
          </bullet>
        </friction>
      </surface>
    </collision>
  </xacro:macro>

  <!-- CAD gimbals face +X; keep the original +Y mount with -30 deg roll. -->
  <xacro:arg name="xyz" default="0.0 0.126 0.130" />
  <xacro:arg name="rpy" default="-0.523598775598 0 0" />

  <link name="base_link">
    <xacro:if value="$(arg use_cad_visual)">
      <xacro:cad_visual mesh="body" material="cad_body" z_scale="${cad_body_z_scale}" />
      <xacro:cad_visual mesh="wheels" material="cad_wheels" />
      <xacro:cad_visual mesh="armor" material="cad_armor" z_scale="${cad_body_z_scale}" />
      <xacro:cad_visual mesh="sensors" material="cad_sensors" z_scale="${cad_sensor_z_scale}"
                        z_origin="${0.130 * (1.0 - cad_sensor_z_scale)}" />
    </xacro:if>
    <xacro:unless value="$(arg use_cad_visual)">
      <visual>
        <geometry>
          <cylinder radius="0.375" length="0.12" />
        </geometry>
        <origin rpy="0 0 0" xyz="0 0 0.06" />
        <material name="orange">
          <color rgba="0.95 0.28 0.04 1" />
        </material>
      </visual>
    </xacro:unless>
    <!-- The new wire-free CAD is a 0.592 x 0.594 m rounded-square chassis.
         Four wheel spheres below model its diagonal corners. -->
    <collision>
      <geometry>
        <cylinder radius="0.280" length="0.12" />
      </geometry>
      <origin rpy="0 0 0" xyz="0 0 0.06" />
    </collision>
    <collision>
      <geometry>
        <!-- Keep the folded collision top 240 mm above the wheel contact plane. -->
        <box size="0.362 0.354 0.040" />
      </geometry>
      <origin rpy="0 0 0" xyz="-0.043 -0.016 ${folded_top_z - 0.020}" />
    </collision>
    <!-- STL has no material density. Preserve the validated 10.2 kg total
         mass, but derive the inertia from the CAD body envelope. -->
    <xacro:box_inertial mass="${body_mass}" x="0.54" y="0.54" z="${0.20 * cad_body_z_scale}"
                         ox="0.0" oy="0.0" oz="0.066" />
  </link>

  <link name="base_footprint"/>
  <joint name="base_footprint_joint" type="fixed">
    <parent link="base_footprint"/>
    <child link="base_link"/>
    <origin xyz="0 0 0" rpy="0 0 0"/>
  </joint>

  <link name="gimbal_yaw"/>
  <joint name="gimbal_yaw_joint" type="fixed">
    <parent link="base_link"/>
    <child link="gimbal_yaw"/>
    <origin xyz="0 0 0.12" rpy="0 0 0"/>
  </joint>

  <link name="wheel_1">
    <xacro:unless value="$(arg use_cad_visual)">
      <visual>
        <geometry>
          <cylinder length="${length_wheel}" radius="${radius_wheel}"/>
        </geometry>
        <material name="black"><color rgba="0.03 0.03 0.03 1"/></material>
      </visual>
    </xacro:unless>
    <collision>
      <geometry>
        <sphere radius="${omni_contact_radius}"/>
      </geometry>
    </collision>
    <xacro:sphere_inertial mass="${wheel_mass}" radius="${omni_contact_radius}" />
  </link>

  <link name="wheel_2">
    <xacro:unless value="$(arg use_cad_visual)">
      <visual><geometry><cylinder length="${length_wheel}" radius="${radius_wheel}"/></geometry><material name="black"/></visual>
    </xacro:unless>
    <collision>
      <geometry>
        <sphere radius="${omni_contact_radius}"/>
      </geometry>
    </collision>
    <xacro:sphere_inertial mass="${wheel_mass}" radius="${omni_contact_radius}" />
  </link>

  <link name="wheel_3">
    <xacro:unless value="$(arg use_cad_visual)">
      <visual><geometry><cylinder length="${length_wheel}" radius="${radius_wheel}"/></geometry><material name="black"/></visual>
    </xacro:unless>
    <collision>
      <geometry>
        <sphere radius="${omni_contact_radius}"/>
      </geometry>
    </collision>
    <xacro:sphere_inertial mass="${wheel_mass}" radius="${omni_contact_radius}" />
  </link>

  <link name="wheel_4">
    <xacro:unless value="$(arg use_cad_visual)">
      <visual><geometry><cylinder length="${length_wheel}" radius="${radius_wheel}"/></geometry><material name="black"/></visual>
    </xacro:unless>
    <collision>
      <geometry>
        <sphere radius="${omni_contact_radius}"/>
      </geometry>
    </collision>
    <xacro:sphere_inertial mass="${wheel_mass}" radius="${omni_contact_radius}" />
  </link>

  <joint name="base_to_wheel1" type="fixed">
    <parent link="base_link"/>
    <child link="wheel_1"/>
    <origin rpy="0 ${PI/2} ${-PI/4}" xyz="${wheel_center_offset} ${-wheel_center_offset} 0"/>
  </joint>

  <joint name="base_to_wheel2" type="fixed">
    <parent link="base_link"/>
    <child link="wheel_2"/>
    <origin rpy="0 ${PI/2} ${-PI/4}" xyz="${-wheel_center_offset} ${wheel_center_offset} 0"/>
  </joint>

  <joint name="base_to_wheel3" type="fixed">
    <parent link="base_link"/>
    <child link="wheel_3"/>
    <origin rpy="0 ${PI/2} ${PI/4}" xyz="${-wheel_center_offset} ${-wheel_center_offset} 0"/>
  </joint>

  <joint name="base_to_wheel4" type="fixed">
    <parent link="base_link"/>
    <child link="wheel_4"/>
    <origin rpy="0 ${PI/2} ${PI/4}" xyz="${wheel_center_offset} ${wheel_center_offset} 0"/>
  </joint>

  <!-- IMU joint -->
  <joint name="imu_joint" type="fixed">
    <axis xyz="0 1 0" />
    <origin xyz="$(arg xyz)" rpy="$(arg rpy)"/>
    <parent link="base_link"/>
    <child link="imu_link"/>
  </joint>

  <!-- IMU -->
  <link name="imu_link">
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.076 0.048 0.040"/>
      </geometry>
    </collision>
    <xacro:unless value="$(arg use_cad_visual)">
      <visual>
        <geometry><box size="0.076 0.048 0.040"/></geometry>
        <material name="green"><color rgba="0 1 0 1"/></material>
      </visual>
    </xacro:unless>
    <inertial>
      <mass value="1e-2" />
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <inertia ixx="1e-6" ixy="0" ixz="0" iyy="1e-6" iyz="0" izz="1e-6" />
    </inertial>
  </link>

  <!-- Gazebo插件设置相关 -->
  <xacro:unless value="$(arg use_cad_visual)">
    <gazebo reference="base_link"><material>Gazebo/Orange</material></gazebo>
  </xacro:unless>
  <!-- Bullet Featherstone shares one friction setting across a link's
       compound collider. Keep the wheels separate so fixed-joint lumping
       cannot replace their omni friction with the chassis default. -->
  <gazebo reference="base_to_wheel1"><preserveFixedJoint>true</preserveFixedJoint></gazebo>
  <gazebo reference="base_to_wheel2"><preserveFixedJoint>true</preserveFixedJoint></gazebo>
  <gazebo reference="base_to_wheel3"><preserveFixedJoint>true</preserveFixedJoint></gazebo>
  <gazebo reference="base_to_wheel4"><preserveFixedJoint>true</preserveFixedJoint></gazebo>
  <gazebo reference="wheel_1">
    <material>Gazebo/Red</material>
    <mu1>${omni_friction}</mu1>
    <mu2>${omni_friction}</mu2>
    <xacro:bullet_omni_friction/>
  </gazebo>
  <gazebo reference="wheel_2">
    <material>Gazebo/Black</material>
    <mu1>${omni_friction}</mu1>
    <mu2>${omni_friction}</mu2>
    <xacro:bullet_omni_friction/>
  </gazebo>
  <gazebo reference="wheel_3">
    <material>Gazebo/Red</material>
    <mu1>${omni_friction}</mu1>
    <mu2>${omni_friction}</mu2>
    <xacro:bullet_omni_friction/>
  </gazebo>
  <gazebo reference="wheel_4">
    <material>Gazebo/Black</material>
    <mu1>${omni_friction}</mu1>
    <mu2>${omni_friction}</mu2>
    <xacro:bullet_omni_friction/>
  </gazebo>
  <gazebo reference="imu_link">
    <material>Gazebo/BuildingFrame</material>
  </gazebo>
  <gazebo reference="left_mid360">
    <material>Gazebo/LightBlueLaser</material>
  </gazebo>

  <!-- Drive controller plugin -->
  <gazebo>
    <plugin name="rm_27_stimulation::CmdVelPoseControlSystem" filename="librm27_cmd_vel_pose_control_system.so">
      <topic>/cmd_vel</topic>
      <body_frame>true</body_frame>
      <command_timeout>0.5</command_timeout>
      <max_linear_velocity>3.0</max_linear_velocity>
      <max_angular_velocity>6.0</max_angular_velocity>
      <linear_velocity_gain>80.0</linear_velocity_gain>
      <!-- The 11.8-degree, low-friction test ramp needs about 21 N to hold this 10.2 kg model. -->
      <linear_velocity_integral_gain>45.0</linear_velocity_integral_gain>
      <angular_velocity_gain>4.0</angular_velocity_gain>
      <max_planar_force>120.0</max_planar_force>
      <max_planar_integral_force>35.0</max_planar_integral_force>
      <!-- Add force only after measured motion stalls along a non-zero command.
           It clears at 0.10 m/s, so no breakaway impulse remains on the slope. -->
      <stall_assist_command_threshold>0.08</stall_assist_command_threshold>
      <stall_assist_engage_velocity>0.02</stall_assist_engage_velocity>
      <stall_assist_release_velocity>0.10</stall_assist_release_velocity>
      <stall_assist_delay>0.20</stall_assist_delay>
      <stall_assist_ramp_rate>100.0</stall_assist_ramp_rate>
      <max_stall_assist_force>45.0</max_stall_assist_force>
      <max_yaw_torque>8.0</max_yaw_torque>
    </plugin>
    <plugin filename="librm27_ground_truth_odometry_system.so" name="rm_27_stimulation::GroundTruthOdometrySystem">
      <odom_publish_frequency>50</odom_publish_frequency>
      <odom_topic>/ground_truth/odometry</odom_topic>
      <odom_frame>world</odom_frame>
      <robot_base_frame>base_footprint</robot_base_frame>
    </plugin>
  </gazebo>

  <!-- mid360_imu plugin -->
  <gazebo reference="imu_link">
    <sensor name="mid360_imu" type="imu">
      <always_on>true</always_on>
      <update_rate>100</update_rate>
      <topic>/livox/imu</topic>
      <gz_frame_id>imu_link</gz_frame_id>
    </sensor>
  </gazebo>

  <!-- Livox-Mid360  -->
  <xacro:include filename="$(find rm_27_stimulation)/urdf/mid360.xacro" />
  <xacro:mid360 name="left_mid360" parent="base_link" topic="/livox/lidar"
                  hide_visual="$(arg use_cad_visual)">
    <origin xyz="$(arg xyz)" rpy="$(arg rpy)" />
  </xacro:mid360>

</robot>
