<?xml version='1.0' encoding='utf-8'?>
<sdf version="1.9">
  <world name="RMUL2027">
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics" />
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands" />
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster" />
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu" />
    <physics name="bullet" default="1" type="bullet">
      <max_step_size>.001</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>
    <scene>
      <ambient>.35 .35 .35 1</ambient>
      <background>.12 .14 .16 1</background>
      <shadows>true</shadows>
      <grid>false</grid>
    </scene>
    <light name="sun" type="directional">
      <pose>0 0 12 0 0 0</pose>
      <diffuse>.65 .65 .65 1</diffuse>
      <specular>.15 .15 .15 1</specular>
      <direction>-.4 .2 -1</direction>
      <cast_shadows>true</cast_shadows>
    </light>
    <include>
      <uri>model://RMUL2027_visual</uri>
      <name>field_visual</name>
      <pose>0 0 0 0 0 0</pose>
    </include>
    <include>
      <uri>model://RMUL2027_collision</uri>
      <name>field_collision</name>
      <pose>0 0 0 0 0 0</pose>
    </include>
    <gravity>0 0 -9.81</gravity>
  </world>
</sdf>