<?xml version="1.0"?>
<sdf version='1.7'>
  <world name='default'>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>

    <!-- 物理引擎 -->
    <physics name='default_physics' default='0' type='ode'>
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>
    
    <!-- 场景 -->
    <scene>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.7 0.7 0.7 1</background>
      <shadows>1</shadows>
    </scene>
    
    <!-- 光源 -->
    <light name='sun' type='directional'>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.8 0.8 0.8 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
      <cast_shadows>1</cast_shadows>
    </light>

    <!-- 地面碰撞覆盖 RMUC2026 场地；传感器可见地面略内缩，避免 gpu_lidar 边缘采样扫到地图外地面。 -->
    <model name='ground_plane'>
      <static>1</static>
      <pose>-0.025 1.640 0 0 0 0</pose>
      <link name='link'>
        <collision name='collision'>
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>29.10 14.95</size>
            </plane>
          </geometry>
        </collision>
        <visual name='visual'>
          <cast_shadows>0</cast_shadows>
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>28.90 14.75</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.5 0.5 0.5 1</ambient>
            <diffuse>0.5 0.5 0.5 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- 场地模型 -->
    <model name='map'>
      <static>1</static>
      <link name='link'>
        <collision name='collision'>
          <geometry>
            <mesh>
              <uri>model://RMUC2026_world/meshes/RMUC2026.stl</uri>
              <scale>1 1 1</scale>
            </mesh>
          </geometry>
          <surface>
            <friction>
              <ode><mu>100</mu><mu2>50</mu2></ode>
            </friction>
          </surface>
        </collision>
        <visual name='visual'>
          <geometry>
            <mesh>
              <uri>model://RMUC2026_world/meshes/RMUC2026.stl</uri>
              <scale>1 1 1</scale>
            </mesh>
          </geometry>
        </visual>
      </link>
      <!-- pose = x y z roll pitch yaw -->
      <pose>0 0 1.65 0 0 0</pose>
    </model>

    <!-- 隐形边界墙 (Invisible Boundaries) -->
    <model name='invisible_boundaries'>
      <static>1</static>
      <!-- 前边墙 (+X) -->
      <link name='wall_front'>
        <pose>14.525 1.640 2.0 0 0 0</pose>
        <collision name='collision'>
          <geometry>
            <box><size>0.2 14.95 4.0</size></box>
          </geometry>
        </collision>
      </link>
      <!-- 后边墙 (-X) -->
      <link name='wall_back'>
        <pose>-14.575 1.640 2.0 0 0 0</pose>
        <collision name='collision'>
          <geometry>
            <box><size>0.2 14.95 4.0</size></box>
          </geometry>
        </collision>
      </link>
      <!-- 左边墙 (+Y) -->
      <link name='wall_left'>
        <pose>-0.025 9.115 2.0 0 0 0</pose>
        <collision name='collision'>
          <geometry>
            <box><size>29.10 0.2 4.0</size></box>
          </geometry>
        </collision>
      </link>
      <!-- 右边墙 (-Y) -->
      <link name='wall_right'>
        <pose>-0.025 -5.835 2.0 0 0 0</pose>
        <collision name='collision'>
          <geometry>
            <box><size>29.10 0.2 4.0</size></box>
          </geometry>
        </collision>
      </link>
    </model>

    <gravity>0 0 -9.81</gravity>
  </world>
</sdf>
