<?xml version="1.0"?>
<sdf version='1.7'>
  <world name='default'>
    <plugin filename="gz-sim-physics-system" name="gz::sim::systems::Physics"/>
    <plugin filename="gz-sim-user-commands-system" name="gz::sim::systems::UserCommands"/>
    <plugin filename="gz-sim-scene-broadcaster-system" name="gz::sim::systems::SceneBroadcaster"/>
    <plugin filename="gz-sim-sensors-system" name="gz::sim::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>
    <plugin filename="gz-sim-imu-system" name="gz::sim::systems::Imu"/>

    <!-- 物理引擎 -->
    <physics name='default_physics' default='0' type='ode'>
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>
    
    <!-- 场景 -->
    <scene>
      <ambient>0.16 0.18 0.22 1</ambient>
      <background>0.06 0.08 0.12 1</background>
      <shadows>1</shadows>
    </scene>

    <gui fullscreen='0'>
      <plugin name='3D View' filename='MinimalScene'>
        <gz-gui>
          <title>3D View</title>
          <property type='bool' key='showTitleBar'>0</property>
          <property type='string' key='state'>docked</property>
        </gz-gui>
        <engine>ogre2</engine>
        <scene>scene</scene>
        <ambient_light>0.16 0.18 0.22</ambient_light>
        <background_color>0.06 0.08 0.12</background_color>
        <camera_pose>-14.5 2.9 8.0 0 1.2 0</camera_pose>
      </plugin>
      <plugin name='Scene Manager' filename='GzSceneManager'>
        <gz-gui>
          <property type='bool' key='showTitleBar'>0</property>
          <property type='bool' key='resizable'>0</property>
          <property type='double' key='width'>5</property>
          <property type='double' key='height'>5</property>
          <property type='string' key='state'>floating</property>
        </gz-gui>
      </plugin>
      <plugin name='Interactive view control' filename='InteractiveViewControl'>
        <gz-gui>
          <property type='bool' key='showTitleBar'>0</property>
          <property type='bool' key='resizable'>0</property>
          <property type='double' key='width'>5</property>
          <property type='double' key='height'>5</property>
          <property type='string' key='state'>floating</property>
        </gz-gui>
      </plugin>
      <plugin name='Camera Tracking' filename='CameraTracking'>
        <gz-gui>
          <property type='bool' key='showTitleBar'>0</property>
          <property type='bool' key='resizable'>0</property>
          <property type='double' key='width'>5</property>
          <property type='double' key='height'>5</property>
          <property type='string' key='state'>floating</property>
        </gz-gui>
      </plugin>
      <plugin name='Select Entities' filename='SelectEntities'>
        <gz-gui>
          <property type='bool' key='showTitleBar'>0</property>
          <property type='bool' key='resizable'>0</property>
          <property type='double' key='width'>5</property>
          <property type='double' key='height'>5</property>
          <property type='string' key='state'>floating</property>
        </gz-gui>
      </plugin>
      <plugin name='World control' filename='WorldControl'>
        <gz-gui>
          <title>World control</title>
          <property type='bool' key='showTitleBar'>0</property>
          <property type='bool' key='resizable'>0</property>
          <property type='double' key='height'>72</property>
          <property type='double' key='width'>121</property>
          <property type='double' key='z'>1</property>
          <property type='string' key='state'>floating</property>
          <anchors target='3D View'>
            <line own='left' target='left'/>
            <line own='bottom' target='bottom'/>
          </anchors>
        </gz-gui>
        <play_pause>1</play_pause>
        <step>1</step>
        <start_paused>0</start_paused>
      </plugin>
      <plugin name='World stats' filename='WorldStats'>
        <gz-gui>
          <title>World stats</title>
          <property type='bool' key='showTitleBar'>0</property>
          <property type='bool' key='resizable'>0</property>
          <property type='double' key='height'>110</property>
          <property type='double' key='width'>290</property>
          <property type='double' key='z'>1</property>
          <property type='string' key='state'>floating</property>
          <anchors target='3D View'>
            <line own='right' target='right'/>
            <line own='bottom' target='bottom'/>
          </anchors>
        </gz-gui>
        <sim_time>1</sim_time>
        <real_time>1</real_time>
        <real_time_factor>1</real_time_factor>
        <iterations>1</iterations>
      </plugin>
      <plugin name='Entity tree' filename='EntityTree'/>
    </gui>
    
    <!-- 光源 -->
    <light name='sun' type='directional'>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.55 0.55 0.55 1</diffuse>
      <specular>0.05 0.05 0.05 1</specular>
      <direction>-0.5 0.1 -0.9</direction>
      <cast_shadows>1</cast_shadows>
    </light>

    <!-- 地面碰撞覆盖 RMUC2026 场地；传感器可见地面略内缩，避免 gpu_lidar 边缘采样扫到地图外地面。 -->
    <model name='ground_plane'>
      <static>1</static>
      <pose>-0.025 1.640 0 0 0 0</pose>
      <link name='link'>
        <collision name='collision'>
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>29.10 14.95</size>
            </plane>
          </geometry>
        </collision>
        <visual name='visual'>
          <cast_shadows>0</cast_shadows>
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>28.90 14.75</size>
            </plane>
          </geometry>
          <material>
            <ambient>0.22 0.22 0.24 1</ambient>
            <diffuse>0.32 0.32 0.34 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- 场地模型 -->
    <model name='map'>
      <static>1</static>
      <link name='link'>
        <collision name='collision'>
          <geometry>
            <mesh>
              <uri>model://RMUC2026_world/meshes/RMUC2026.stl</uri>
              <scale>1 1 1</scale>
            </mesh>
          </geometry>
          <surface>
            <friction>
              <ode><mu>100</mu><mu2>50</mu2></ode>
            </friction>
          </surface>
        </collision>
        <visual name='visual'>
          <geometry>
            <mesh>
              <uri>model://RMUC2026_world/meshes/RMUC2026.stl</uri>
              <scale>1 1 1</scale>
            </mesh>
          </geometry>
          <material>
            <ambient>0.28 0.30 0.32 1</ambient>
            <diffuse>0.58 0.60 0.62 1</diffuse>
            <specular>0.04 0.04 0.04 1</specular>
          </material>
        </visual>
      </link>
      <!-- pose = x y z roll pitch yaw -->
      <pose>0 0 1.65 0 0 0</pose>
    </model>

    <!-- 隐形边界墙 (Invisible Boundaries) -->
    <model name='invisible_boundaries'>
      <static>1</static>
      <!-- 前边墙 (+X) -->
      <link name='wall_front'>
        <pose>14.525 1.640 2.0 0 0 0</pose>
        <collision name='collision'>
          <geometry>
            <box><size>0.2 14.95 4.0</size></box>
          </geometry>
        </collision>
      </link>
      <!-- 后边墙 (-X) -->
      <link name='wall_back'>
        <pose>-14.575 1.640 2.0 0 0 0</pose>
        <collision name='collision'>
          <geometry>
            <box><size>0.2 14.95 4.0</size></box>
          </geometry>
        </collision>
      </link>
      <!-- 左边墙 (+Y) -->
      <link name='wall_left'>
        <pose>-0.025 9.115 2.0 0 0 0</pose>
        <collision name='collision'>
          <geometry>
            <box><size>29.10 0.2 4.0</size></box>
          </geometry>
        </collision>
      </link>
      <!-- 右边墙 (-Y) -->
      <link name='wall_right'>
        <pose>-0.025 -5.835 2.0 0 0 0</pose>
        <collision name='collision'>
          <geometry>
            <box><size>29.10 0.2 4.0</size></box>
          </geometry>
        </collision>
      </link>
    </model>

    <gravity>0 0 -9.81</gravity>
  </world>
</sdf>
