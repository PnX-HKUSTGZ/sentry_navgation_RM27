<?xml version="1.0"?>
<sdf version='1.7'>
  <world name='default'>
    <!-- 物理引擎 -->
    <physics name='default_physics' default='0' type='ode'>
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1</real_time_factor>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>
    
    <!-- 场景 -->
    <scene>
      <ambient>0.4 0.4 0.4 1</ambient>
      <background>0.7 0.7 0.7 1</background>
      <shadows>1</shadows>
    </scene>
    
    <!-- 光源 -->
    <include>
      <uri>model://sun</uri>
    </include>

    <!-- 地面平面 -->
    <include>
      <uri>model://ground_plane</uri>
    </include>

    <!-- 场地模型 -->
    <model name='map'>
      <static>1</static>
      <link name='link'>
        <collision name='collision'>
          <geometry>
            <mesh>
              <uri>model://RMUC2026_world/meshes/RMUC2026.stl</uri>
              <scale>1 1 1</scale>
            </mesh>
          </geometry>
          <surface>
            <friction>
              <ode><mu>100</mu><mu2>50</mu2></ode>
            </friction>
          </surface>
        </collision>
        <visual name='visual'>
          <geometry>
            <mesh>
              <uri>model://RMUC2026_world/meshes/RMUC2026.stl</uri>
              <scale>1 1 1</scale>
            </mesh>
          </geometry>
        </visual>
      </link>
      <!-- pose = x y z roll pitch yaw -->
      <pose>0 0 1.65 0 0 0</pose>
    </model>

    <!-- 隐形边界墙 (Invisible Boundaries) -->
    <model name='invisible_boundaries'>
      <static>1</static>
      <!-- 前边墙 (+X) -->
      <link name='wall_front'>
        <pose>14.525 1.640 2.0 0 0 0</pose>
        <collision name='collision'>
          <geometry>
            <box><size>0.2 14.95 4.0</size></box>
          </geometry>
        </collision>
      </link>
      <!-- 后边墙 (-X) -->
      <link name='wall_back'>
        <pose>-14.575 1.640 2.0 0 0 0</pose>
        <collision name='collision'>
          <geometry>
            <box><size>0.2 14.95 4.0</size></box>
          </geometry>
        </collision>
      </link>
      <!-- 左边墙 (+Y) -->
      <link name='wall_left'>
        <pose>-0.025 9.115 2.0 0 0 0</pose>
        <collision name='collision'>
          <geometry>
            <box><size>29.10 0.2 4.0</size></box>
          </geometry>
        </collision>
      </link>
      <!-- 右边墙 (-Y) -->
      <link name='wall_right'>
        <pose>-0.025 -5.835 2.0 0 0 0</pose>
        <collision name='collision'>
          <geometry>
            <box><size>29.10 0.2 4.0</size></box>
          </geometry>
        </collision>
      </link>
    </model>

    <gravity>0 0 -9.81</gravity>
  </world>
</sdf>
