<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>rm27_backend</name>
  <version>0.0.1</version>
  <description>Point-LIO adaptation, bounded keyframes and incremental GTSAM pose graph.</description>
  <!-- 联系人邮箱为占位值，请替换为项目维护者的实际地址。 -->
  <maintainer email="pnx@example.com">PnX</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>
  <depend>rclcpp</depend><depend>nav_msgs</depend><depend>sensor_msgs</depend>
  <depend>diagnostic_msgs</depend><depend>rm27_localization_interfaces</depend>
  <depend>eigen</depend><depend>libpcl-all-dev</depend><depend>gtsam</depend>
  <depend>tbb</depend>
  <depend>geometry_msgs</depend><depend>tf2_ros</depend><depend>tf2_eigen</depend>
  <depend>boost</depend>
  <exec_depend>launch_ros</exec_depend>
  <test_depend>ament_cmake_gtest</test_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
