+  const auto blocked = [](int, int) { return column({1, 2, 3, 4, 5}); };
+  const auto blind = [](int, int) {
+    rog_map::ColumnStats stats;
+    stats.vertical_states.assign(11U, rog_map::VerticalVoxelState::UNKNOWN);
