-void TeleopTwistJoyNode::fillJointStateMsg(
-  const sensor_msgs::msg::Joy::SharedPtr joy_msg, const std::string & which_map,
-  sensor_msgs::msg::JointState * joint_state_msg)
-{
-  static double pitch = 0.0;
-  static double yaw = 0.0;
