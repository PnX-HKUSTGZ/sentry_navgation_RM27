-#define MTK_JACOB_RIGHT(         type, id) if(id.IDX == idx){id.Jacob_right(vec, res);}
-#define MTK_S2_hat(          type, id) if(id.IDX == idx){id.S2_hat(res);}
-#define MTK_S2_Nx_yy(            type, id) if(id.IDX == idx){id.S2_Nx_yy(res);}
