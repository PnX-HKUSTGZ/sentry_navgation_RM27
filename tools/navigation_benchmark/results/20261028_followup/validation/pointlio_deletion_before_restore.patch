-  const size_t bits = std::numeric_limits<T>::digits;
-  const T high_bit(T(1) << (bits - 1));
-  const size_t bit_count(bits * N);
-
-  std::array<T, N> out;
-
-  std::fill(out.begin(), out.end(), 0);
-
-  // go through all bits in input, msb first.  Shift distances
-  // are from msb.
