-//
-// Based on the paper "Programming the Hilbert Curve" by John Skilling.
-//
-// Index is encoded with most significant objects first.  Lexographic
-//  sort order.
-//template<typename T, size_t N>
-//std::array<T, N>
-//PositionToIndex(std::array<T, N> const &in);
