-struct traits {
-	typedef typename Manifold::scalar scalar;
-	enum {DOF = Manifold::DOF};
-	typedef vect<DOF, scalar> vectorized_type;
-	typedef Eigen::Matrix<scalar, DOF, DOF> matrix_type;
-};
