<?xml version="1.0" encoding="UTF-8"?>
<!-- Keep complete simulated point clouds in the local shared-memory transport.
     Fast DDS's default 512 KiB segment is smaller than one cloud in this scene.
     No topic QoS, sensor samples, timestamps, or estimator parameters change. -->
<profiles xmlns="http://www.eprosima.com/XMLSchemas/fastRTPS_Profiles">
  <transport_descriptors>
    <transport_descriptor>
      <transport_id>mapping_shm</transport_id>
      <type>SHM</type>
      <segment_size>67108864</segment_size>
    </transport_descriptor>
    <transport_descriptor>
      <transport_id>mapping_udp</transport_id>
      <type>UDPv4</type>
    </transport_descriptor>
  </transport_descriptors>
  <participant profile_name="mapping_large_cloud" is_default_profile="true">
    <rtps>
      <userTransports>
        <transport_id>mapping_shm</transport_id>
        <transport_id>mapping_udp</transport_id>
      </userTransports>
      <useBuiltinTransports>false</useBuiltinTransports>
    </rtps>
  </participant>
</profiles>
